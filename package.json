{
    "name": "com.magithar.socketio-unity",
    "version": "1.2.0",
    "displayName": "Socket.IO Unity Client",
    "description": "Open-source Socket.IO v4 client for Unity (Standalone & WebGL)",
    "unity": "2020.1",
    "dependencies": {
        "com.unity.nuget.newtonsoft-json": "3.2.2"
    },
    "keywords": [
        "socketio",
        "websocket",
        "networking",
        "realtime"
    ],
    "author": {
        "name": "Magithar",
        "url": "https://github.com/Magithar"
    },
    "license": "MIT",
    "samples": [
        {
            "displayName": "Basic Chat",
            "description": "Simple chat demo — recommended starting point.",
            "path": "Samples~/BasicChat"
        },
        {
            "displayName": "Player Sync",
            "description": "Real-time multiplayer position synchronization demo.",
            "path": "Samples~/PlayerSync"
        },
        {
            "displayName": "Lobby",
            "description": "Multiplayer lobby with host migration, session identity, and reconnect recovery.",
            "path": "Samples~/Lobby"
        }
    ]
